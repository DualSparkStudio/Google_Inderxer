# Database — SQLite for local dev
DATABASE_URL="file:./dev.db"

# For PostgreSQL on production, replace with:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Server port
PORT=4000

# Frontend origin (for CORS)
FRONTEND_URL="http://localhost:3000"

# Which indexing providers to enable (comma-separated)
# Available: google_indexing, ping_discovery
INDEXING_PROVIDERS="google_indexing,ping_discovery"

# ── Google Indexing API credentials (required for google_indexing provider) ───

# Option A: paste the entire service account JSON as a single-line string
# Best for Render / Railway / Vercel (no file upload needed)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: path to the downloaded .json key file
# Best for local development
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# Optional: Redis for BullMQ queue (leave empty to use in-process worker)
# REDIS_URL="redis://localhost:6379"

# Node environment
NODE_ENV="development"
