# Database — SQLite for local dev
DATABASE_URL="file:./dev.db"

# For PostgreSQL on production, replace with:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Server port
PORT=4000

# Frontend origin (for CORS)
FRONTEND_URL="http://localhost:3000"

# Which indexing providers to enable (comma-separated, executed in order)
# Options: google_bridge, reddit_signal, twitter_signal, google_indexing, ping_discovery, sitemap_ping, bing_url_submission, websub, ping_services
INDEXING_PROVIDERS="google_bridge,reddit_signal,twitter_signal,google_indexing,ping_discovery,sitemap_ping,bing_url_submission,websub,ping_services"

# ── 100% Free Reddit Real-Time Signal (Google partnership firehose) ───────────
# Get free script app credentials at: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your-client-id
# REDDIT_CLIENT_SECRET=your-client-secret
# REDDIT_USERNAME=your-reddit-username
# REDDIT_PASSWORD=your-reddit-password
# REDDIT_SUBREDDIT=your_subreddit_or_empty_for_user_profile

# ── Twitter / X Real-Time Signal ──────────────────────────────────────────────
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# ── Google Bridge (System B for third-party URLs) ─────────────────────────────
BRIDGE_HOST=index.dualsparkstudio.com

# ── Google Indexing API credentials ───────────────────────────────────────────
# Option A: paste entire service account JSON as string (Best for Render/Railway/Vercel)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
# Option B: local path to downloaded .json key file (Best for local dev)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ── Bing Webmaster API (free — get key at https://www.bing.com/webmasters) ───
# BING_WEBMASTER_API_KEY=

# Node environment
NODE_ENV="development"
